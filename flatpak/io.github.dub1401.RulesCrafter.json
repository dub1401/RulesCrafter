{
	"app-id": "io.github.dub1401.RulesCrafter",
	"runtime": "org.kde.Platform",
	"runtime-version": "6.11",
	"sdk": "org.kde.Sdk",
	"base": "com.riverbankcomputing.PyQt.BaseApp",
	"base-version": "6.11",
	"cleanup-commands": [
		"pip uninstall uv -y",
		"/app/cleanup-BaseApp.sh"
	],
	"build-options": {
		"env": [
			"BASEAPP_REMOVE_WEBENGINE=1"
		]
	},
	"command": "craft",
	"separate-locales": false,
	"rename-icon": "icon",
	"finish-args": [
		"--socket=wayland"
	],
	"modules": [
		"python3-modules.json",
		{
			"name": "rulescraft",
			"buildsystem": "simple",
			"build-commands": [
				"uv pip install --verbose --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} .",
				"install -Dm644 flatpak/icon.svg -t /app/share/icons/hicolor/scalable/apps",
				"install -Dm644 flatpak/$FLATPAK_ID.metainfo.xml -t /app/share/metainfo",
				"install -Dm644 flatpak/$FLATPAK_ID.desktop -t /app/share/applications"
			],
			"sources": [
				{
					"type": "git",
					"url": "https://github.com/DUB1401/RulesCrafter",
					"branch": "main"
				}
			]
		}
	]
}